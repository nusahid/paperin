{
  "name": "folio",
  "productName": "Folio",
  "version": "0.1.0",
  "description": "Your offline PDF workspace. Open. Read. Organize. Save.",
  "author": "Folio",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs && node scripts/create-samples.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.ts *.cjs package.json README.md",
    "format:check": "prettier --check src tests scripts *.ts *.cjs package.json README.md",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "setup:qpdf": "node scripts/setup-qpdf.mjs",
    "samples": "node scripts/create-samples.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/test": "^1.65.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
